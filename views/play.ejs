<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="/css/style.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-900 text-white">
    <!-- Video Title -->
    <div class="flex items-center justify-center my-4">
      <a href="/<%= folder %>" class="absolute left-4 p-2 bg-gray-800 text-white rounded-full hover:bg-gray-700">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>
      </a>
      <h1 id="currentTitle" class="text-3xl font-semibold"><%= title %></h1>
    </div>

    <!-- Video Player -->
    <div class="flex justify-center my-4">
      <video id="videoPlayer" class="max-w-full max-h-screen bg-black" controls autoplay>
        <source id="videoSource" src="/stream/<%= folder %>/<%= file %>" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Navigation Buttons -->
    <div class="flex items-center justify-center my-4 gap-2">
      <button
        id="prevButton"
        class="flex items-center px-4 py-2 bg-gray-800 text-white rounded-full hover:bg-gray-700 hidden"
      >
        Previous
      </button>
      <button
        id="nextButton"
        class="flex items-center px-4 py-2 bg-gray-800 text-white rounded-full hover:bg-gray-700 gap-2 hidden"
      >
        <div
          id="countdownCircle"
          class="w-6 h-6 rounded-full bg-gray-600 text-center text-white leading-6 hidden"
        >
          3
        </div>
        <span id="nextText">Next</span>
      </button>
    </div>

    <script src="/js/videoPlayer.js"></script>
  </body>
</html>
