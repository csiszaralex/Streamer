{
  "name": "streamer",
  "version": "1.0.0",
  "description": "A streaming platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:prod": "pnpm run build && pnpm run copy-frontend",
    "copy-frontend": "shx rm -rf apps/backend/client && shx mkdir -p apps/backend/client && shx cp -r apps/frontend/dist/* apps/backend/client/",
    "start:prod": "node apps/backend/dist/main.js",
    "lint": "turbo lint",
    "test": "turbo test"
  },
